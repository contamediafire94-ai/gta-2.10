<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0D10">

    <!-- Barra lateral estilo launcher -->
    <LinearLayout
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#12151A">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WIU"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:paddingBottom="28dp" />

        <Button
            android:id="@+id/button_servers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SERVIDORES"
            android:textColor="#FFFFFF"
            android:backgroundTint="#232832" />

        <Button
            android:id="@+id/button_favorites"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="FAVORITOS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#232832" />

        <Button
            android:id="@+id/button_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="CONFIGURAÇÕES"
            android:textColor="#FFFFFF"
            android:backgroundTint="#232832" />
    </LinearLayout>

    <!-- Conteúdo principal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servidores"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Escolha um servidor ou conecte por IP"
            android:textColor="#8D96A5"
            android:textSize="15sp" />

        <!-- Card de conexão direta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="#151920">

            <EditText
                android:id="@+id/edit_server"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="IP:Porta"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#697181"
                android:backgroundTint="#697181"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:inputType="textUri" />

            <Button
                android:id="@+id/button_play"
                android:layout_width="150dp"
                android:layout_height="52dp"
                android:layout_marginLeft="14dp"
                android:text="JOGAR"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2D6CDF" />
        </LinearLayout>

        <!-- Área que depois receberá a lista real de servidores -->
        <LinearLayout
            android:id="@+id/server_list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#11151B">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LISTA DE SERVIDORES"
                android:textColor="#7F8998"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="A lista de servidores aparecerá aqui."
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
