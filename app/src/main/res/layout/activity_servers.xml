<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#090B0E">

    <!-- Barra lateral -->
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="18dp"
        android:background="#101318">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WIU"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp"
            android:text="LAUNCHER"
            android:textColor="#707887"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:letterSpacing="0.18" />

        <Button
            android:id="@+id/button_servers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SERVIDORES"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#2D6CDF" />

        <Button
            android:id="@+id/button_favorites"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="FAVORITOS"
            android:textColor="#C8CED8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#181D25" />

        <Button
            android:id="@+id/button_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="CONFIGURAÇÕES"
            android:textColor="#C8CED8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#181D25" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SA-MP MOBILE"
            android:textColor="#535B69"
            android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Conteúdo principal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="26dp"
        android:paddingTop="24dp"
        android:paddingRight="26dp"
        android:paddingBottom="22dp">

        <!-- Cabeçalho -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servidores"
            android:textColor="#F4F6F8"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Escolha um servidor para jogar"
            android:textColor="#7C8594"
            android:textSize="14sp" />

        <!-- Nick + Jogar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="#13171D">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Digite seu Nick"
                    android:textColor="#8A94A3"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <EditText
                    android:id="@+id/edit_nick"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:hint="Nome_Sobrenome"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#626B79"
                    android:textSize="15sp"
                    android:backgroundTint="#3C4553"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:selectAllOnFocus="true"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <Button
                android:id="@+id/button_play"
                android:layout_width="145dp"
                android:layout_height="50dp"
                android:layout_marginLeft="16dp"
                android:text="JOGAR"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.08"
                android:backgroundTint="#2D6CDF"
                android:elevation="3dp" />
        </LinearLayout>

        <!-- Lista com rolagem -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:background="#10141A">

            <LinearLayout
                android:id="@+id/server_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LISTA DE SERVIDORES"
                    android:textColor="#737D8D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
